          "type": "dec",
          "missing": [
            "NA"
          ],
          "scale": 4
        },
        {
          "name": "padj",
          "type": "dec",
          "missing": [
            "NA"
          ],
          "scale": 5
        },
        {
          "name": "baseMean",
