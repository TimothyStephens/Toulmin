{
  "description": "derive with arithmetic, log, and coalesce",
  "input": {
    "steps": 1,
    "tables": {
      "de": "F7@v2"
    },
    "from": "de",
    "ops": [
      {
        "op": "derive",
        "v": 1,
        "as": "score",
        "expr": "-log10(coalesce(padj, 1)) * abs(log2FoldChange)"
      },
      {
        "op": "filter",
        "v": 1,
        "where": "score > 2 and not (baseMean < 10)"
      }
    ]
  },
  "specs": {
    "de": {
      "spec": 1,
      "format": "tsv",
      "delimiter": "\t",
      "header": true,
      "columns": [
        {
          "name": "gene_id",
          "type": "str",
          "missing": []
        },
        {
          "name": "log2FoldChange",
          "type": "dec",
          "missing": [
            "NA"
          ],
          "scale": 4
        },
        {
          "name": "padj",
          "type": "dec",
          "missing": [
            "NA"
          ],
          "scale": 5
        },
        {
          "name": "baseMean",
          "type": "float64",
          "missing": [
            "NA"
          ]
        }
      ],
      "key": [
        "gene_id"
      ],
      "nan": "missing",
      "inf": "missing",
      "encoding": "utf-8"
    },
    "samples": {
      "spec": 1,
      "format": "tsv",
      "delimiter": "\t",
      "header": true,
      "columns": [
        {
          "name": "sample_id",
          "type": "str",
          "missing": []
        },
        {
          "name": "gene_id",
          "type": "str",
          "missing": []
        },
        {
          "name": "condition",
          "type": "str",
          "missing": []
        },
        {
          "name": "date",
          "type": "date",
          "missing": [
            "NA"
          ]
        },
        {
          "name": "count",
          "type": "int",
          "missing": [
            "NA"
          ]
        },
        {
          "name": "ok",
          "type": "bool",
          "missing": []
        }
      ],
      "key": [
        "sample_id",
        "gene_id"
      ],
      "nan": "missing",
      "inf": "missing",
      "encoding": "utf-8"
    }
  },
  "expect": {
    "valid": true
  }
}
