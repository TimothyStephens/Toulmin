---
source: crates/tm-checker/tests/snapshot_sql.rs
---
-- input.gm: c0 = "id" (str), c1 = "g" (dec), c2 = "v" (int); key "id"
SELECT "row" FROM "input.gm" ORDER BY "c0" COLLATE "binary" ASC NULLS FIRST;

-- step0: c0 = "id" (str), c1 = "g" (dec), c2 = "v" (int); key "id"
-- step0 also: key = the row's key tuple as canonical JSON (str)
SELECT first("row" ORDER BY "row") AS "rep", list("row" ORDER BY "row") AS "members", count(*) AS "member_count", 'sha256:' || sha256('[' || string_agg("key", ',' ORDER BY "key" COLLATE "binary") || ']') AS "member_keys_hash", NULL AS "a0" FROM "step0" GROUP BY "c1" ORDER BY "c1" COLLATE "binary" ASC NULLS FIRST;
