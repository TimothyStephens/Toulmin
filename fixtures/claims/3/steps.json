{
  "steps": 1,
  "tables": {
    "de": "F1@v1"
  },
  "from": "de",
  "ops": [
    {
      "op": "derive",
      "v": 1,
      "as": "up",
      "expr": "log2FoldChange > 0"
    },
    {
      "op": "group",
      "v": 1,
      "by": [
        "up"
      ],
      "aggregates": [
        {
          "as": "n",
          "fn": "count",
          "column": "gene_id"
        },
        {
          "as": "mean_lfc",
          "fn": "mean",
          "column": "log2FoldChange"
        }
      ]
    }
  ]
}
